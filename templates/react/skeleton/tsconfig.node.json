{
  // コンパイラの設定
  "compilerOptions": {
    // ビルド情報のキャッシュ出力先（composite に必要）
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    // プロジェクト参照（build モード）を可能にする
    "composite": true,
    // 出力する JS のターゲット
    "target": "ES2022",
    // 使用するライブラリ定義（DOM は不要）
    "lib": ["ES2022"],
    // モジュール方式
    "module": "ESNext",
    // モジュール解決方式（bundler 向け）
    "moduleResolution": "bundler",
    // 型チェックのみ行い JS は出力しない
    "noEmit": true,
    // 各ファイルを独立してトランスパイル可能にする
    "isolatedModules": true,
    // CommonJS との相互運用を有効化する
    "esModuleInterop": true,
    // 厳格な型チェックを有効化する
    "strict": true,
    // ライブラリの型チェックをスキップする
    "skipLibCheck": true
  },
  // 型チェック対象に含めるファイル（ビルドツールの設定）
  "include": ["vite.config.ts"]
}
