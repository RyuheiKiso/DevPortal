{
  "name": "@k1s0-ts-http/react-native",
  "version": "0.1.0",
  "description": "DevPortal HTTP クライアントの React Native 連携（HttpClientProvider / hooks / Platform 別 fetch / NetInfo 連携）",
  "license": "UNLICENSED",
  "private": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "react-native": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "react-native": "./dist/esm/index.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run build && node -e \"const fs=require('fs');const p=JSON.parse(fs.readFileSync('package.json','utf8'));p.dependencies['@k1s0-ts-http/core']=p.version;fs.writeFileSync('package.json',JSON.stringify(p,null,2)+'\\n');\"",
    "postpublish": "node -e \"const fs=require('fs');const p=JSON.parse(fs.readFileSync('package.json','utf8'));p.dependencies['@k1s0-ts-http/core']='file:../core';fs.writeFileSync('package.json',JSON.stringify(p,null,2)+'\\n');\""
  },
  "dependencies": {
    "@k1s0-ts-http/core": "file:../core"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.73.0",
    "@types/react": "*",
    "@react-native-community/netinfo": "*"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@react-native-community/netinfo": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-native-community/netinfo": "^11.0.0",
    "@types/react": "^19.0.0",
    "react": "^19.2.0",
    "react-native": "^0.84.0",
    "typescript": "~5.8.3"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
