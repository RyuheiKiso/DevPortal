{
  "name": "@k1s0-ts-camera/react-native",
  "version": "0.1.0",
  "description": "DevPortal React Native bindings for the headless camera framework (vision-camera / expo-camera / Windows MediaCapture).",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "react-native": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "react-native": "./dist/esm/index.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./adapters/vision": {
      "types": "./dist/esm/adapters/visionCameraAdapter.d.ts",
      "react-native": "./dist/esm/adapters/visionCameraAdapter.js",
      "import": "./dist/esm/adapters/visionCameraAdapter.js",
      "require": "./dist/cjs/adapters/visionCameraAdapter.js"
    },
    "./adapters/expo": {
      "types": "./dist/esm/adapters/expoCameraAdapter.d.ts",
      "react-native": "./dist/esm/adapters/expoCameraAdapter.js",
      "import": "./dist/esm/adapters/expoCameraAdapter.js",
      "require": "./dist/cjs/adapters/expoCameraAdapter.js"
    },
    "./adapters/windows": {
      "types": "./dist/esm/adapters/windowsAdapter.d.ts",
      "react-native": "./dist/esm/adapters/windowsAdapter.js",
      "import": "./dist/esm/adapters/windowsAdapter.js",
      "require": "./dist/cjs/adapters/windowsAdapter.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "windows-native",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json',JSON.stringify({type:'commonjs'},null,2)+'\\n')\"",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "prepack": "node ../scripts/pack-local-dependency.cjs prepare @k1s0-ts-camera/core version",
    "postpack": "node ../scripts/pack-local-dependency.cjs restore"
  },
  "dependencies": {
    "@k1s0-ts-camera/core": "file:../core"
  },
  "peerDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
    "expo-av": ">=14.0.0",
    "expo-camera": ">=15.0.0",
    "react": ">=18.0.0 <20.0.0",
    "react-native": ">=0.73.0 <1.0.0",
    "react-native-vision-camera": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "expo-av": {
      "optional": true
    },
    "expo-camera": {
      "optional": true
    },
    "react-native-vision-camera": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "react": "^19.2.0",
    "react-native": "^0.84.0",
    "react-test-renderer": "^19.2.0",
    "typescript": "~5.8.3",
    "vitest": "^4.1.7"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "http://localhost:4873/"
  }
}
