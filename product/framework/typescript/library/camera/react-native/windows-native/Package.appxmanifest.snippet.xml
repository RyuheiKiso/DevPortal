<!--
  ============================================================================
  Package.appxmanifest.snippet.xml
  利用者プロジェクトの windows/<AppName>/Package.appxmanifest に追記する
  カメラ・マイク capability の抜粋。
  既存の <Capabilities> ブロックに以下 2 行を追加してください
  （<Capabilities> ブロックが無い場合は </Application> の直後に挿入）。
  ============================================================================
-->
<Capabilities>
  <!-- カメラ利用に必須 -->
  <DeviceCapability Name="webcam" />
  <!-- 動画録画でマイクを使う場合に必要（写真のみなら省略可） -->
  <DeviceCapability Name="microphone" />
</Capabilities>
