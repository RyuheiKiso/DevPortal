// 利用者プロジェクトの windows/<AppName>/ReactPackageProvider.cpp に追記する
// K1s0Camera NativeModule の登録コード。既存の CreatePackage 関数本体に
// AddModule 行を 1 行追加してください。
//
// 完成形イメージ:
//
//   void ReactPackageProvider::CreatePackage(IReactPackageBuilder const& packageBuilder) noexcept
//   {
//       AddAttributedModules(packageBuilder, true);
//       // ↓ ここを追加
//       packageBuilder.AddModule(L"K1s0Camera",
//           MakeTurboModuleProvider<K1s0CameraNative::implementation::K1s0Camera>());
//   }
//
// また、ファイル先頭に以下の #include を追加してください:
//
//   #include "K1s0Camera.h"
// ============================================================================

// （追加 #include）
#include "K1s0Camera.h"

// （CreatePackage 関数本体に追加する 1 行）
packageBuilder.AddModule(L"K1s0Camera",
    MakeTurboModuleProvider<K1s0CameraNative::implementation::K1s0Camera>());
