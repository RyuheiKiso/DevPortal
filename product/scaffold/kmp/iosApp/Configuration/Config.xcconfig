// ============================================================================
// Config.xcconfig
// Xcode ビルド変数の集中管理ファイル
// プロジェクト直接編集ではなく本ファイルを変更してリポジトリ差分を最小化する
// ============================================================================

// アプリ名 (Xcode の "Display Name" 相当)
APP_NAME = KMP Scaffold

// バンドル ID (App Store / プロビジョニングプロファイルと一致させる)
BUNDLE_ID = com.example.kmpapp

// 対応する最低 iOS バージョン (低くしすぎると Compose 動作要件と衝突する)
IPHONEOS_DEPLOYMENT_TARGET = 15.0

// Xcode の開発チーム ID (空のままだと自動署名が選択できない)
//   Apple Developer Portal の「Team ID」をここに入れる
DEVELOPMENT_TEAM =
