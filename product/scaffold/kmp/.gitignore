# ===========================================================================
# Git 無視設定 (KMP / CMP プロジェクト用)
# ===========================================================================

# --- Gradle ----------------------------------------------------------------
# Gradle のローカルキャッシュ・出力ディレクトリ
.gradle/
build/
# 任意の build 配下生成物
**/build/

# --- IDE (IntelliJ / Android Studio) --------------------------------------
# IntelliJ の設定 (個人設定はチームに共有しない)
.idea/
# ワークスペース固有ファイル
*.iml
*.iws
*.ipr

# --- Kotlin / Native ------------------------------------------------------
# Kotlin Native 中間ファイル
.kotlin/
# CocoaPods 同梱時の Pods キャッシュ
Pods/

# --- Android --------------------------------------------------------------
# local.properties (SDK パスなど開発者ごとの設定)
local.properties
# キーストアなど機密情報
*.jks
*.keystore

# --- iOS / Xcode ----------------------------------------------------------
# Xcode ユーザー個別設定
xcuserdata/
# Xcode ビルド成果物
DerivedData/
*.xcuserstate

# --- macOS / OS ファイル ---------------------------------------------------
# macOS Finder メタデータ
.DS_Store
# Windows サムネイル
Thumbs.db

# --- Node / Web (wasmJs ターゲット使用時) ---------------------------------
# Compose for Web 系の node_modules キャッシュ
node_modules/
# Yarn キャッシュ
.yarn/
# Webpack 中間生成物
**/kotlin-js-store/
